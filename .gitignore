scrape_state.json

# Logs
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# Playwright browser binaries (installed via `playwright install`, not committed)
.cache/ms-playwright/

# Editor/OS cruft
.DS_Store
.vscode/
.idea/
