# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Scraper ---
SCRAPER_BACKEND=mock                 # mock | http | playwright
FSBO_SOURCE_URL_TEMPLATE=
FSBO_LISTING_CARD_SELECTOR=
FSBO_ADDRESS_SELECTOR=
FSBO_PRICE_SELECTOR=
FSBO_LINK_SELECTOR=
FSBO_BEDS_SELECTOR=
FSBO_BATHS_SELECTOR=
FSBO_SQFT_SELECTOR=
MAX_ITEMS_PER_ZIP=25

# --- Supabase (REST API, used by main.py) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Supabase (direct Postgres connection, used by migrate.py only) ---
DATABASE_URL=

# --- Skip trace ---
SKIP_TRACE_PROVIDER=mock             # mock | batchdata
SKIP_TRACE_API_KEY=
SKIP_TRACE_MAX_RETRIES=3
SKIP_TRACE_BACKOFF_BASE_SECS=1.0
SKIP_TRACE_MAX_CALLS_PER_RUN=200
SKIP_TRACE_MIN_INTERVAL_SECS=0.25

# --- Outreach (Gmail) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_FORMAT=text                      # text | json
NOTIFY_WEBHOOK_URL=

# --- Dedup / scheduler ---
DEDUP_STATE_FILE=dedup_state.json
RESCRAPE_COOLDOWN_HOURS=24
SCRAPE_STATE_FILE=scrape_state.json
